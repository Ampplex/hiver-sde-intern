# AWS Bedrock Configuration
# Bedrock runtime permissions required for:
#  - amazon.titan-embed-text-v2:0 (query embeddings & classification)
#  - mistral.mistral-large-2407-v1:0 (response generation & CapabilityGuard safety verification)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-west-2

# AWS Bedrock Model Identifiers
BEDROCK_MODEL_ID=mistral.mistral-large-2407-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024

# Agent Gating Thresholds (Optional overrides; default values baked into code)
INTENT_SIMILARITY_THRESHOLD=0.45
INTENT_MARGIN_THRESHOLD=0.02
